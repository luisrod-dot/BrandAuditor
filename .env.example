# Copia este archivo como .env.local para probar en tu computador con `vercel dev`.
# En Vercel, estas mismas variables van en Settings > Environment Variables.

# Obligatoria. Clave de la API de Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=

# Recomendada. Código que debe escribir quien use la página. Si queda vacío, la ruta queda abierta a cualquiera con el link.
ACCESS_CODE=

# Opcionales. Cambian el modelo de cada nivel de análisis.
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-opus-5-5
